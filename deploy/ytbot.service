[Unit]
Description=YouTube Analyses Telegram Bot
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/youtube-analyses
ExecStart=/home/YOUR_USER/youtube-analyses/venv/bin/python tools/bot_service.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
