# Copy this file to .env and fill in your values
# .env is gitignored — never commit it
# For GitHub Actions: add these as Repository Secrets in Settings → Secrets → Actions

# YouTube Data API v3 (console.cloud.google.com)
YOUTUBE_API_KEY=

# OpenAI API key (platform.openai.com)
OPENAI_API_KEY=

# Google OAuth 2.0 (for Gmail + Sheets) — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets: filled automatically on first export run
GOOGLE_SHEETS_ID=

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID: filled automatically on first Telegram run
TELEGRAM_CHAT_ID=

# Optional: GitHub API token for GitHub Trending source (higher rate limits)
# In GitHub Actions, use GH_TOKEN (conflicts with built-in GITHUB_TOKEN)
GH_TOKEN=

# Optional: Telegram API credentials for Telegram Channels source (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Optional: Google Places API key for Google Maps source
GOOGLE_PLACES_API_KEY=

# Optional: SOCKS proxy (if YouTube API is not reachable directly)
# HTTPS_PROXY=socks4://127.0.0.1:10808
